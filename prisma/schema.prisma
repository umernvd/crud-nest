datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
}

model Post {
  id      Int     @id @default(autoincrement())
  title   String
  content String?
}
